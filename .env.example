# Copy to .env (gitignored) or export these in your shell.
# Nothing here is read from a committed file: .env is for your convenience only.

# xoxb- bot token. Needed to post cards. `send` works without it, it just prints
# the receive command instead of posting to Slack.
SLACK_BOT_TOKEN=

# xapp- app-level token. Only `sideband bot` needs this.
SLACK_APP_TOKEN=

# Optional defaults, all overridable per invocation.
# SIDEBAND_CHANNEL=data
# SIDEBAND_TTL_HOURS=24
# SIDEBAND_MAX_DOWNLOADS=0
# SIDEBAND_RELAY_URL=
